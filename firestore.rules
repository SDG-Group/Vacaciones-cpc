rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /data/users/{id}/{rest=**} {
      allow read, write: if request.auth != null;
    }
    match /perfiles/{id} {
      allow read, write: if request.auth != null;
    }
    match /{col}/{doc=**} {
      allow read, write: if request.auth != null && col in ['config', 'vacaciones', 'movimientos'];
    }
  }
}
